            "hash": "529e78a9cec6cd7e3e014f7ecd8bda0c113969d4ed0f2efeedb85c30943325b8"
        },
        "32bit": {
            "url": "https://github.com/astral-sh/uv/releases/download/0.13.8/uv-i686-pc-windows-msvc.zip",
            "hash": "4fbc1489e659e46acc9f39215c2f849a8f6cca76cea2a34ab88bb203d6be4548"
        },
        "arm64": {
            "url": "https://github.com/astral-sh/uv/releases/download/0.13.8/uv-aarch64-pc-windows-msvc.zip",
            "hash": "59e6d919bed1f72035e622a7c930058f08a8931c4c78ceaf9f56e7fb74dd2c48"
        }
    },
    "bin": [
        "uv.exe",
        "uvx.exe",
        "uvw.exe"
    ],
    "env_add_path": "tools\\bin",
    "env_set": {
        "UV_CACHE_DIR": "$persist_dir\\cache",
        "UV_CONFIG_DIR": "$persist_dir\\config",
        "UV_TOOL_DIR": "$persist_dir\\tools",
        "UV_PYTHON_INSTALL_DIR": "$persist_dir\\python"
    },
    "persist": [
        "cache",
        "config",
        "tools",
        "python"
    ],
    "notes": "uv's cache, config, tools and python installations are set directly to the Scoop persist directory.",
    "checkver": {
        "github": "https://github.com/astral-sh/uv"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/astral-sh/uv/releases/download/$version/uv-x86_64-pc-windows-msvc.zip"
            },
            "32bit": {
                "url": "https://github.com/astral-sh/uv/releases/download/$version/uv-i686-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/astral-sh/uv/releases/download/$version/uv-aarch64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
